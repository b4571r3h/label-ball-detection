# SSL-aktivierte Caddy-Konfiguration für beide Apps
{
    # Automatische HTTPS aktiviert (Let's Encrypt)
    email basti@basti-reh.de
}

# Hauptdomain mit HTTPS
app.basti-reh.de {
    # Root-Redirect zu Ball Detection
    redir / /ball-detection/ 302
    
    # Ball Detection Labeler
    handle /ball-detection/* {
        reverse_proxy tt-ball-labeler:8000
    }
    
    # Ball Analyzer (with root-path configured)
    handle_path /ball-analyzer/* {
        reverse_proxy tt-ball-analyzer:8001
    }
    
    # Admin Panel - Redirect old double path
    redir /admin/admin/* /admin/ 302
    
    # Admin Panel - Explicit route for root
    redir /admin /admin/ 302
    
    # Admin Panel
    handle_path /admin/* {
        reverse_proxy tt-ball-admin:8002
    }
    
    # Fallback
    respond "🏓 TT Ball Detection & Analysis Platform (HTTPS)" 200
}

# Ball-Labeler unter eigener Domain (United-domains: spinevo.app)
# DNS: Subdomain balls.spinevo.app → A/AAAA auf dieselbe Server-IP wie der Reverse-Proxy.
# Pfade werden auf /ball-detection/* gemappt (gleicher Container, APP_ROOT_PATH bleibt /ball-detection).
balls.spinevo.app {
    rewrite * /ball-detection{http.request.uri}
    reverse_proxy tt-ball-labeler:8000
}

# SpinEvo Dev (dev.spinevo.app)
# DNS: Subdomain dev.spinevo.app → A/AAAA auf dieselbe Server-IP.
dev.spinevo.app {
    reverse_proxy tt-dev-spinevo:3000
}

# HTTP zu HTTPS Redirect (automatisch von Caddy)
# Caddy leitet automatisch HTTP-Traffic zu HTTPS um
